     print("[ok] base_w sanity: \\xff\\x00 ->", digits)
 
+    # checksum encoding boundary tests (the bug was: base_w(c.to_bytes(32,'big'),3))
+    assert wots_checksum(0) == [0, 0, 0], wots_checksum(0)
